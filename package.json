{
  "name": "autoachado-api-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Probe descartavel de viabilidade da API oficial do Mercado Livre para o AutoAchado.AI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "probe:live": "tsx src/live.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
