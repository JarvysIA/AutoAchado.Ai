{
  "name": "autoachado-api-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Probe descartavel de viabilidade da API oficial do Mercado Livre para o AutoAchado.AI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "pnpm typecheck && pnpm bundle:vercel && pnpm verify:vercel-output",
    "bundle:vercel": "esbuild src/vercel-handler.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/index.js --legal-comments=none --charset=utf8",
    "verify:vercel-output": "node scripts/verify-vercel-output.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:runtime": "pnpm smoke:vercel-runtime",
    "smoke:vercel-runtime": "node scripts/smoke-runtime.mjs",
    "smoke:vercel-http": "node scripts/smoke-vercel-http.mjs",
    "probe:live": "tsx src/live.ts",
    "db:start": "supabase start --exclude gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "test:db": "supabase test db",
    "test:db:concurrency": "node scripts/test-oauth-initialize-concurrency.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "supabase": "2.115.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3"
  }
}
